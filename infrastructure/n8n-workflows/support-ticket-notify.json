    {
      "parameters": {
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/support_tickets?select=*&telegram_notified_at=is.null&order=created_at.asc&limit=10",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_SERVICE_KEY }}"
            },
            {
