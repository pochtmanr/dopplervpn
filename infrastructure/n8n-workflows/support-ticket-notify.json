      },
      "id": "tick-fetch",
      "name": "Fetch Unnotified Tickets",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        224,
        0
      ],
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 3000,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "\n// One item per unnotified ticket; HTML-escaped for parse_mode: HTML.\n// topic 'business' rows come from the landing business inquiry form and get their own layout.\nconst esc = (s) => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst INQUIRY = { partnership: 'Partnership', enterprise: 'Enterprise / Team', press: 'Press / Media', reseller: 'Reseller / Affiliate', other: 'Other' };\nconst INDUSTRY = { tech_saas: 'Technology / SaaS', media_press: 'Media & Press', finance: 'Finance', education: 'Education', healthcare: 'Healthcare', travel: 'Travel & Hospitality', retail_ecommerce: 'Retail & E-commerce', government_ngo: 'Government / NGO', telecom_isp: 'Telecom / ISP', other: 'Other' };\nconst resp = $('Fetch Unnotified Tickets').first().json;\nconst rows = Array.isArray(resp.body) ? resp.body : [];\nreturn rows.map(t => {\n  const desc = (t.description || '').trim();\n  const trimmed = desc.length > 500 ? desc.slice(0, 500) + '…' : desc;\n  const when = esc(String(t.created_at || '').replace('T', ' ').slice(0, 16)) + ' UTC';\n  const admin = '<a href=\"https://admin.dopplervpn.org/admin-dvpn/tickets/' + encodeURIComponent(t.id) + '\">Open in admin</a>';\n  let lines;\n  if (t.topic === 'business') {\n    lines = [\n      '\\u{1F4BC} <b>New Business Inquiry</b> — <code>' + esc(t.ticket_number) + '</code>',\n      '',\n      '<b>Type:</b> ' + esc(INQUIRY[t.inquiry_type] || t.inquiry_type || '—'),\n      '<b>Company:</b> ' + esc(t.company_name || '—'),\n      '<b>Industry:</b> ' + esc(t.industry ? (INDUSTRY[t.industry] || t.industry) : '—'),\n      '<b>Name:</b> ' + esc(t.contact_name || '—'),\n      '<b>Website:</b> ' + esc(t.company_website || '—'),\n      '',\n      esc(trimmed),\n      '',\n      '<b>Email:</b> ' + esc(t.contact_email),\n      '<i>' + when + '</i> · ' + admin,\n    ];\n  } else {\n    lines = [\n      '\\u{1F3AB} <b>New Support Ticket</b> — <code>' + esc(t.ticket_number) + '</code>',\n      '',\n      '<b>Topic:</b> ' + esc(t.topic) + '  ·  <b>Priority:</b> ' + esc(t.priority || 'normal'),\n      '<b>Subject:</b> ' + esc(t.subject),\n      '',\n      esc(trimmed),\n      '',\n      '<b>Email:</b> ' + esc(t.contact_email),\n      '<b>Account:</b> ' + (t.account_id ? '<code>' + esc(t.account_id) + '</code>' : '—'),\n      '<i>' + when + ' · reply to the email above</i> · ' + admin,\n    ];\n  }\n  return { json: { id: t.id, ticket_number: t.ticket_number, text: lines.join('\\n') } };\n});\n"
      },
      "id": "tick-format",
      "name": "Format Tickets",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        0
