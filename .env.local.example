# Doppler VPN — web (dopplervpn.org)
#
# Copy to `.env.local` and fill from the password manager / Vercel project.
# Names only — never commit a real value. Every variable the code reads is
# listed here; if you add a `process.env.X`, add X here in the same commit.
#
# Groups marked REQUIRED must be set or the app will not boot / core flows fail.

# ── Supabase — REQUIRED ──────────────────────────────────────────────
# Project ref is fzlrhmjdjjzcgstaeblu. The anon key is public by design (it
# ships in the client bundle and in every native client). The service-role key
# bypasses all RLS — server-only, never expose it, never prefix with NEXT_PUBLIC.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Site URL — REQUIRED in production ────────────────────────────────
# Without it `lib/site-url.ts` falls back to the request Host header, which is
# attacker-controlled and feeds payment callback/return URLs. Set it in Vercel.
NEXT_PUBLIC_SITE_URL=https://www.dopplervpn.org

# ── Revolut checkout — REQUIRED for card payments ────────────────────
REVOLUT_SECRET_KEY=
NEXT_PUBLIC_REVOLUT_PUBLIC_KEY=
REVOLUT_ENVIRONMENT=sandbox
REVOLUT_WEBHOOK_SECRET=

# ── OxaPay crypto checkout — REQUIRED for crypto payments ────────────
OXAPAY_MERCHANT_API_KEY=
OXAPAY_SANDBOX=true

# ── SMTP — REQUIRED for account recovery and receipts ────────────────
# Used by verification codes, the "here is your Account ID" recovery mail and
# purchase receipts. Port 465 implies TLS.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# From-address for receipts; falls back to SMTP_USER, then the canonical
# support address in lib/facts.ts.
RECEIPT_FROM_ADDRESS=
# Receipts only send when this is exactly "true".
RECEIPT_EMAILS_ENABLED=false

# ── Internal API auth ────────────────────────────────────────────────
# Shared secret the native clients send as `X-API-Key` to /api/vpn/*.
APP_API_SECRET=
# Bearer token for POST /api/revalidate (on-demand ISR purge).
REVALIDATE_SECRET=

# ── Dev-only entitlement grant ───────────────────────────────────────
# Enables POST /api/dev/grant-pro, which flips an account to Pro without a
# payment. The route 404s whenever VERCEL_ENV or NODE_ENV is "production",
# regardless of this value. Leave unset in production.
DEV_GRANT_SECRET=

# ── Windows release serving ──────────────────────────────────────────
# Version + URL advertised by /api/windows/update.
WINDOWS_LATEST_VERSION=
WINDOWS_DOWNLOAD_URL=
# JSON blob served by /api/windows/releases/*.
WINDOWS_RELEASES_JSON=

# ── Android APK serving ──────────────────────────────────────────────
# "github" (default) redirects to the GitHub release; "proxy" streams the APK
# through us from ANDROID_APK_ORIGIN_URL.
ANDROID_APK_SOURCE=github
ANDROID_APK_ORIGIN_URL=

# ── Analytics ────────────────────────────────────────────────────────
# Set NEXT_PUBLIC_GA_MEASUREMENT_ID in Vercel PRODUCTION ONLY — leaving it unset
# in Preview/Development keeps staging traffic out of the property, and every
# helper in src/lib/ga.ts no-ops without it.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Measurement Protocol secret for the server-side Windows download count.
# GA4 Admin -> Data Streams -> Measurement Protocol API secrets. Server-only.
GA_API_SECRET=

# ── Affiliate postbacks ──────────────────────────────────────────────
# Defaults to http://postback.info/postback.php when unset.
POSTBACK_BASE_URL=
POSTBACK_CID_DOWNLOAD=
POSTBACK_CID_PURCHASE=

# ── ipinfo.io ────────────────────────────────────────────────────────
# ipinfo.io Lite token (free, ipinfo.io/signup). Server-only. /api/ip uses it for
# the ISP name and ASN; without it those fields are null and the page still works.
IPINFO_TOKEN=
